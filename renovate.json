{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "schedule": [
    "* 6 * * 1"
  ],
  "timezone": "Europe/Berlin",
  "dependencyDashboard": true,
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "description": "Security PRs open at once and never automerge, so a human reads every one",
    "automerge": false
  },
  "automerge": false,
  "automergeStrategy": "squash",
  "minimumReleaseAge": "3 days",
  "prHourlyLimit": 0,
  "labels": [
    "dependencies",
    "renovate"
  ],
  "rangeStrategy": "pin",
  "packageRules": [
    {
      "matchManagers": [
        "nuget"
      ],
      "matchDepNames": [
        "Aspire.AppHost.Sdk"
      ],
      "rangeStrategy": "replace"
    },
    {
      "matchManagers": [
        "nuget"
      ],
      "matchDepNames": [
        "Aspire.AppHost.Sdk"
      ],
      "matchUpdateTypes": [
        "pin"
      ],
      "enabled": false
    },
    {
      "description": "Non-major updates merge on their own once CI is green",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "automerge": true
    },
    {
      "description": "Majors get their own PR per group (separateMajorMinor) and are never automerged, so they stay visible; the dev, test and CI rules below opt back in",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false,
      "addLabels": [
        "major"
      ]
    },
    {
      "description": "One PR per production area, so a red build points at a small set of packages",
      "matchManagers": [
        "npm"
      ],
      "groupName": "frontend dependencies",
      "groupSlug": "frontend"
    },
    {
      "matchManagers": [
        "nuget",
        "msbuild-sdk"
      ],
      "groupName": "backend dependencies",
      "groupSlug": "backend"
    },
    {
      "description": "Tools versioned in lockstep with the backend packages, found by regex managers",
      "matchDepNames": [
        "dotnet-ef",
        "dotnet-sdk"
      ],
      "groupName": "backend dependencies",
      "groupSlug": "backend"
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "groupName": "container images",
      "groupSlug": "container-images"
    },
    {
      "description": "Dev, test and CI dependencies: majors merge on green CI too, because they never ship",
      "matchManagers": [
        "github-actions"
      ],
      "automerge": true,
      "groupName": "GitHub Actions",
      "groupSlug": "github-actions"
    },
    {
      "matchManagers": [
        "npm"
      ],
      "matchDepTypes": [
        "devDependencies",
        "packageManager"
      ],
      "automerge": true,
      "groupName": "frontend dev dependencies",
      "groupSlug": "frontend-dev"
    },
    {
      "description": "Test and build-tooling packages in Directory.Packages.props; a package missing here defaults to the production rules (safe side)",
      "matchManagers": [
        "nuget"
      ],
      "matchPackageNames": [
        "TUnit{/,}**",
        "AwesomeAssertions",
        "Deque.AxeCore.Playwright",
        "NetArchTest.Rules",
        "NSubstitute",
        "Respawn",
        "Aspire.Hosting.Testing",
        "Microsoft.Extensions.Diagnostics.Testing",
        "NSwag.MSBuild"
      ],
      "automerge": true,
      "groupName": "backend test dependencies",
      "groupSlug": "backend-test"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^(keycloak/)?AGENTS\\.md$/",
        "/^docs/Architecture/src/.*\\.adoc$/",
        "/^docs/Architecture/images/.*\\.puml$/",
        "/^README\\.md$/",
        "/^backend/src/Aspire/AppHost/AppHost\\.cs$/",
        "/^\\.github/workflows/dotnet\\.yml$/",
        "/^\\.github/workflows/publish\\.yml$/"
      ],
      "matchStrings": [
        "Keycloak (?<currentValue>[\\d]+\\.[\\d]+\\.[\\d]+)",
        "quay\\.io/keycloak/keycloak:(?<currentValue>[\\d]+\\.[\\d]+\\.[\\d]+)",
        "quay\\.io/keycloak/keycloak\",\\s*\"(?<currentValue>[\\d]+\\.[\\d]+\\.[\\d]+)"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "quay.io/keycloak/keycloak"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^backend/src/Aspire/AppHost/AppHost\\.cs$/",
        "/^\\.github/workflows/dotnet\\.yml$/",
        "/^\\.github/workflows/publish\\.yml$/"
      ],
      "matchStrings": [
        "ghcr\\.io/axllent/mailpit:(?<currentValue>v[\\d]+\\.[\\d]+\\.[\\d]+)",
        "ghcr\\.io/axllent/mailpit\",\\s*\"(?<currentValue>v[\\d]+\\.[\\d]+\\.[\\d]+)"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "ghcr.io/axllent/mailpit"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^backend/src/Aspire/AppHost/AppHost\\.cs$/",
        "/^\\.github/workflows/dotnet\\.yml$/",
        "/^\\.github/workflows/publish\\.yml$/"
      ],
      "matchStrings": [
        "rustfs/rustfs:(?<currentValue>[\\d]+\\.[\\d]+\\.[\\d]+)",
        "rustfs/rustfs\",\\s*\"(?<currentValue>[\\d]+\\.[\\d]+\\.[\\d]+)"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "rustfs/rustfs"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^AGENTS\\.md$/",
        "/^README\\.md$/"
      ],
      "matchStrings": [
        "SDK (?<currentValue>[\\d]+\\.[\\d]+\\.[\\d]+), see `backend/global\\.json`",
        "\\.NET SDK \\*\\*(?<currentValue>[\\d]+\\.[\\d]+\\.[\\d]+)\\*\\*",
        "pinned in `backend/global\\.json` \\((?<currentValue>[\\d]+\\.[\\d]+\\.[\\d]+)\\)"
      ],
      "datasourceTemplate": "dotnet-version",
      "depNameTemplate": "dotnet-sdk"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/dotnet\\.yml$/"
      ],
      "matchStrings": [
        "dotnet tool install --global dotnet-ef --version (?<currentValue>[\\d]+\\.[\\d]+\\.[\\d]+)"
      ],
      "datasourceTemplate": "nuget",
      "depNameTemplate": "dotnet-ef"
    }
  ]
}
