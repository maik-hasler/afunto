{
  "name": "afunto",
  "type": "module",
  "version": "1.0.0",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": "25.9.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "size": "size-limit",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "mutation": "stryker run",
    "mutation:since": "stryker run --since=origin/main",
    "mutation:components": "stryker run stryker.components.json",
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"*.{ts,js}\"",
    "format:write": "prettier --write \"src/**/*.{ts,tsx,css}\" \"*.{ts,js}\"",
    "i18n:check": "node scripts/check-i18n-keys.js",
    "check:agents-inventory": "node scripts/check-agents-inventory.js",
    "check:a11y-rules": "node scripts/check-a11y-rule-parity.js",
    "check:backend-constants": "node scripts/check-backend-constants.js",
    "client:generate": "node scripts/normalize-openapi.js && openapi-ts",
    "tokens:generate": "node scripts/generate-design-tokens.js",
    "check:design-tokens": "node scripts/check-design-tokens.js",
    "check:client-current": "node scripts/check-client-current.js",
    "check:deps": "node scripts/check-module-graph.js",
    "check:nginx-csp": "node scripts/check-nginx-csp.js",
    "check:config-defer": "node scripts/check-config-defer.js",
    "check:nginx-gzip-static": "node scripts/check-nginx-gzip-static.js",
    "check:nginx-hsts": "node scripts/check-nginx-hsts.js",
    "check:nginx-permissions-policy": "node scripts/check-nginx-permissions-policy.js",
    "check:pwa-precache": "node scripts/check-pwa-precache.js",
    "check:pwa-manifest": "node scripts/check-pwa-manifest.js",
    "check:pwa-offline-caching": "node scripts/check-pwa-offline-caching.js",
    "check:pwa-silent-renew-fallback": "node scripts/check-pwa-silent-renew-fallback.js"
  },
  "dependencies": {
    "@fontsource-variable/source-sans-3": "5.3.0",
    "@fontsource/barlow-condensed": "5.3.0",
    "@hookform/resolvers": "5.9.1",
    "@tanstack/react-query": "^5.103.1",
    "date-fns": "4.4.0",
    "i18next": "26.4.2",
    "i18next-browser-languagedetector": "8.2.1",
    "jsqr": "1.4.0",
    "leaflet": "1.9.4",
    "oidc-client-ts": "3.5.0",
    "qrcode.react": "4.2.0",
    "react": "19.3.0",
    "react-big-calendar": "1.20.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.88.0",
    "react-i18next": "17.0.14",
    "react-leaflet": "5.0.0",
    "react-oidc-context": "3.3.1",
    "react-router": "8.4.0",
    "workbox-window": "7.4.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@hey-api/openapi-ts": "^0.99.0",
    "@size-limit/file": "^14.0.0",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/leaflet": "1.9.22",
    "@types/react": "19.3.0",
    "@types/react-big-calendar": "1.16.3",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.1",
    "axe-core": "4.13.0",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-i18next": "6.1.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-tailwindcss": "4.4.0",
    "jsdom": "30.1.0",
    "prettier": "3.9.8",
    "prettier-plugin-tailwindcss": "0.8.1",
    "size-limit": "^14.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vite-plugin-compression2": "2.5.3",
    "vite-plugin-pwa": "1.3.0",
    "vite-plugin-svgr": "5.2.0",
    "vitest": "5.0.1",
    "vitest-axe": "0.1.0"
  }
}
