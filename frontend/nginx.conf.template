gzip on;
gzip_static on;
gzip_types text/plain text/css text/javascript application/javascript application/json image/svg+xml;
gzip_min_length 1024;
gzip_vary on;

# Single source of truth for the Content-Security-Policy value. The $host
# map key is a no-op (server_name is the catch-all "_"), used only as the
# idiomatic nginx trick for defining a reusable constant outside of a
# location block - add_header does not inherit across location blocks
# that define their own add_header (e.g. Cache-Control below), so every
# location still has to re-emit this header, but from one definition
# instead of four copies that can drift out of sync.
map $host $csp_header {
	default "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: ${CSP_API_ORIGIN} ${CSP_STORAGE_ORIGIN}; font-src 'self'; connect-src 'self' ${CSP_API_ORIGIN} ${CSP_KEYCLOAK_ORIGIN}; frame-src 'self' ${CSP_KEYCLOAK_ORIGIN}; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'";
}

# silent-renew.html's own policy (#2042) - frame-src 'self' above only governs
# what the *parent* page is allowed to embed; whether the browser actually
# renders silent-renew.html inside that hidden iframe is a separate check
# against frame-ancestors on silent-renew.html's *own* response, enforced
# independently of the parent's CSP. Every other page keeps frame-ancestors
# 'none' (no exceptions to the site-wide anti-clickjacking policy above) -
# this is scoped to the one route that legitimately needs to be framed, via
# its own location block below rather than a blanket relaxation.
map $host $csp_header_silent_renew {
	default "default-src 'self'; script-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'self'";
}

# Recognizes social-preview and search-engine crawlers by User-Agent so a shared or
# crawled deep link to a specific opportunity/organization gets that entity's own
# title/description/image instead of the site-wide metadata frontend/index.html
# hardcodes (afunto#1680) - real browsers never match this and are served the
# unmodified SPA shell below, same as today.
map $http_user_agent $is_social_bot {
	default 0;
	"~*(facebookexternalhit|Twitterbot|Slackbot|LinkedInBot|TelegramBot|Discordbot|WhatsApp|SkypeUriPreview|Googlebot|bingbot|Applebot|redditbot|Pinterest|Baiduspider|YandexBot)" 1;
}

server {
	listen 80;
	server_name _;
	root /usr/share/nginx/html;
	index index.html;

	# The privacy policy (privacyPolicy.section2Body4) states visitor IP addresses
	# are never stored - true for the backend's in-memory rate limiter and scoped
	# HttpLogging, but nginx's base image (nginx:1.31-alpine) otherwise applies its
	# default access-log format, which includes the client IP, and container stdout
	# is routinely collected (afunto#1730). Disabled here to keep that claim
	# accurate.
	access_log off;

	add_header X-Content-Type-Options "nosniff" always;
	add_header X-Frame-Options "DENY" always;
	add_header X-XSS-Protection "1; mode=block" always;
	add_header Referrer-Policy "strict-origin-when-cross-origin" always;
	add_header Permissions-Policy "camera=(self), microphone=(), geolocation=(self), payment=()" always;
	add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
	add_header Content-Security-Policy $csp_header always;

	location / {
		try_files $uri $uri/ /index.html;
	}

	# The homepage's own preview. Split out from `location /` above because that
	# one is a prefix match covering every SPA path, and only the site root should
	# resolve to the "home" entry of the backend's StaticPageCatalog
	# (afunto#2331).
	location = / {
		if ($is_social_bot) {
			rewrite ^ /__meta/pages/home last;
		}
		try_files $uri $uri/ /index.html;
	}

	location = /config.js {
		add_header Cache-Control "no-store" always;
		add_header X-Content-Type-Options "nosniff" always;
		add_header X-Frame-Options "DENY" always;
		add_header X-XSS-Protection "1; mode=block" always;
		add_header Referrer-Policy "strict-origin-when-cross-origin" always;
		add_header Permissions-Policy "camera=(self), microphone=(), geolocation=(self), payment=()" always;
		add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
		add_header Content-Security-Policy $csp_header always;
	}

	# nginx's default mime.types has no .webmanifest entry, so it falls back to
	# default_type (application/octet-stream) instead of the
	# application/manifest+json the W3C Web App Manifest spec requires
	# (afunto#1966) - most browsers are lenient about it, but a strict
	# installability check (some Lighthouse configs, some non-Chromium engines)
	# can refuse to treat a non-application/manifest+json response as a valid
	# manifest. Matches both locale manifests (manifest.de.webmanifest,
	# manifest.en.webmanifest, afunto#1923) rather than one exact
	# filename, since index.html's <link rel="manifest"> is swapped between
	# them at runtime (frontend/src/i18n.ts) as the visitor's language changes.
	location ~ ^/manifest\.(de|en)\.webmanifest$ {
		default_type application/manifest+json;
	}

	location ~* \.(js|css|png|jpg|jpeg|gif|svg|ico|woff2?)$ {
		expires 1y;
		add_header Cache-Control "public, immutable" always;
		add_header X-Content-Type-Options "nosniff" always;
		add_header X-Frame-Options "DENY" always;
		add_header X-XSS-Protection "1; mode=block" always;
		add_header Referrer-Policy "strict-origin-when-cross-origin" always;
		add_header Permissions-Policy "camera=(self), microphone=(), geolocation=(self), payment=()" always;
		add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
		add_header Content-Security-Policy $csp_header always;
	}

	location = /index.html {
		add_header Cache-Control "no-store" always;
		add_header X-Content-Type-Options "nosniff" always;
		add_header X-Frame-Options "DENY" always;
		add_header X-XSS-Protection "1; mode=block" always;
		add_header Referrer-Policy "strict-origin-when-cross-origin" always;
		add_header Permissions-Policy "camera=(self), microphone=(), geolocation=(self), payment=()" always;
		add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
		add_header Content-Security-Policy $csp_header always;
	}

	# main.tsx's silent_redirect_uri (#2042) - automaticSilentRenew/signinSilent()
	# load this same-origin page inside a hidden iframe, which needs
	# X-Frame-Options: SAMEORIGIN and frame-ancestors 'self' (via
	# $csp_header_silent_renew above) instead of every other page's DENY/'none' -
	# without both, the browser refuses to render it in that iframe regardless
	# of frame-src on the parent. Cache-Control matches /index.html above for
	# the same reason: this HTML references a content-hashed JS filename that
	# changes on every release, so it must never be served stale from cache.
	location = /silent-renew.html {
		add_header Cache-Control "no-store" always;
		add_header X-Content-Type-Options "nosniff" always;
		add_header X-Frame-Options "SAMEORIGIN" always;
		add_header X-XSS-Protection "1; mode=block" always;
		add_header Referrer-Policy "strict-origin-when-cross-origin" always;
		add_header Permissions-Policy "camera=(self), microphone=(), geolocation=(self), payment=()" always;
		add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
		add_header Content-Security-Policy $csp_header_silent_renew always;
	}

	# Shared/crawled deep links to a specific opportunity or organization
	# (afunto#1680) - a social-preview crawler or search engine (see
	# $is_social_bot above) gets rewritten to the internal /__meta/... location
	# below instead, which proxies to the backend's per-entity HTML. Everyone
	# else (i.e. every real browser) falls through to try_files exactly as
	# before, so the SPA experience here is unchanged.
	location ~ ^/(volunteer-opportunities|organizations)/[0-9a-fA-F-]+$ {
		if ($is_social_bot) {
			rewrite ^ /__meta$uri last;
		}
		try_files $uri $uri/ /index.html;
	}

	# The same treatment for the static routes (afunto#2331). Those used to
	# fall straight through to index.html, whose og:url/canonical is one hardcoded
	# string pointing at the site root - so /help pasted into Slack, WhatsApp or a
	# Facebook post previewed as the homepage and declared the homepage canonical.
	# The site root itself is covered by the `location = /` block above; the copy
	# for every one of these lives in the backend's StaticPageCatalog.
	location ~ ^/(opportunities|organizations|help|contact|imprint|privacy-policy|terms-of-use)$ {
		if ($is_social_bot) {
			rewrite ^/(.+)$ /__meta/pages/$1 last;
		}
		try_files $uri $uri/ /index.html;
	}

	# Internal-only rewrite target for the bot branch above - proxied rather than
	# served as a static file since it needs the opportunity/organization's
	# current title/description/banner from the database. Same cross-subdomain
	# proxy rationale as /sitemap.xml below (afunto#1092).
	location ~ ^/__meta/(volunteer-opportunities|organizations)/([0-9a-fA-F-]+)$ {
		internal;
		resolver ${DNS_RESOLVER} valid=10s;
		set $backend_upstream ${BACKEND_UPSTREAM};
		set $meta_entity_type $1;
		set $meta_entity_id $2;
		proxy_pass $backend_upstream/v1/meta/$meta_entity_type/$meta_entity_id;
	}

	# Internal-only rewrite target for the static-route bot branch above. The copy
	# is static, but it is the backend that holds it (StaticPageCatalog) so the
	# sitemap and these previews cannot list different sets of pages.
	location ~ ^/__meta/pages/([a-z-]+)$ {
		internal;
		resolver ${DNS_RESOLVER} valid=10s;
		set $backend_upstream ${BACKEND_UPSTREAM};
		set $meta_page_slug $1;
		proxy_pass $backend_upstream/v1/meta/pages/$meta_page_slug;
	}

	# A sitemap must be served from the same host as the URLs it lists, or crawlers
	# reject its entries - but the backend and this frontend are reached under
	# different hostnames, and the sitemap's content is DB-backed (published
	# opportunities/organizations), so it can't be a static file here either
	# (afunto#1092). Proxied instead, over the container network both
	# already share.
	#
	# proxy_pass's target is a variable ($backend_upstream), not a literal
	# hostname - with a literal, nginx resolves it once at config load and
	# caches that IP for the worker's lifetime, so a backend container restart
	# (a new IP on the same service name) would leave this location proxying
	# to a dead address until nginx itself reloads. A variable forces
	# re-resolution on every request instead, via the `resolver` below.
	# $backend_upstream/$resolver default to a Compose/user-defined-network
	# setup with a service named "backend" (127.0.0.11 is Docker's embedded
	# DNS server) but are templated from BACKEND_UPSTREAM/DNS_RESOLVER at
	# container start (99-runtime-config.sh) rather than hardcoded, since
	# nothing guarantees that service name on every deployment
	# (afunto#2196).
	location = /sitemap.xml {
		resolver ${DNS_RESOLVER} valid=10s;
		set $backend_upstream ${BACKEND_UPSTREAM};
		proxy_pass $backend_upstream/v1/sitemap.xml;
	}
}
