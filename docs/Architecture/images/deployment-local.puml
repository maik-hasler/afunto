@startuml Local Development Deployment

!include <C4/C4_Deployment>

title Deployment View - Local Development (.NET Aspire)

Deployment_Node(machine, "Developer Machine", "Windows / macOS / Linux") {
	Deployment_Node(aspire, ".NET Aspire AppHost", "Aspire / DCP orchestration") {

		Deployment_Node(frontend_node, "frontend (host process)") {
			Container(frontend, "Single Page Application", "Vite Dev Server (from source)", ":4321")
		}

		Deployment_Node(backend_node, "backend (host process)") {
			Container(backend, "Backend API", "ASP.NET Core .NET 10 (from source)", ":5000")
		}

		Deployment_Node(keycloak_node, "keycloak (container)") {
			Container(keycloak, "Identity Provider", "Keycloak 26.7.4 (upstream, dev-file DB)", ":8080")
		}

		Deployment_Node(postgres_node, "postgres (container)") {
			ContainerDb(postgres, "PostgreSQL", "PostgreSQL 18", ":5432")
		}

		Deployment_Node(pgadmin_node, "pgadmin (container)") {
			Container(pgadmin, "DB Management UI", "pgAdmin 4", ":5050")
		}

		Deployment_Node(mailpit_node, "mailpit (container)") {
			Container(mailpit, "Mail capture", "Mailpit", ":1080 / :1025")
		}

		Deployment_Node(storage_node, "storage (container)") {
			Container(storage, "Object storage", "RustFS (S3-compatible)", ":9000 / :9001")
		}
	}
}

Rel(frontend, backend, "REST API", "HTTP :5000")
Rel(frontend, keycloak, "OIDC", "HTTP :8080")
Rel(backend, postgres, "SQL / EF Core", "TCP :5432")
Rel(backend, keycloak, "JWKS + Admin API", "HTTP :8080")
Rel(backend, mailpit, "SMTP", "TCP :1025")
Rel(backend, storage, "S3 API", "HTTP :9000")
Rel(pgadmin, postgres, "DB management", "TCP :5432")

@enduml
