@startuml Technical Context

!include <C4/C4_Context>

title Technical Context View

Person(volunteer, "Volunteer", "Uses browser to access the platform")
Person(organizer, "Organizer", "Uses browser to manage opportunities")
Person(admin, "Platform Admin", "Uses browser to moderate and administer")

System(afunto, "Afunto", "Volunteer coordination platform")

System_Ext(browser, "Web Browser", "Any modern browser (Chrome, Firefox, Safari, Edge)")
System_Ext(ghcr, "GitHub Container Registry", "Stores Docker images for all components")
System_Ext(github_actions, "GitHub Actions", "CI: builds, tests, and publishes images")
System_Ext(keycloak, "Keycloak", "Identity provider (OIDC, JWT), self-hosted")
System_Ext(postgres, "PostgreSQL", "Application and realm database, self-hosted")
System_Ext(nominatim, "OpenStreetMap Nominatim", "Address geocoding (public, rate-limited)")
System_Ext(smtp, "SMTP mail server", "Outbound notification and reminder emails")
System_Ext(objectstore, "Object storage (RustFS / S3)", "Binary assets: logos, avatars, banners")

Rel(volunteer, browser, "Opens")
Rel(organizer, browser, "Opens")
Rel(admin, browser, "Opens")
Rel(browser, afunto, "HTTPS", "React SPA, REST API, OIDC")
Rel(github_actions, ghcr, "Publishes images to")
Rel(afunto, keycloak, "Authenticates via / validates JWT", "OIDC, JWKS")
Rel(afunto, postgres, "Reads / writes", "TCP / SQL")
Rel(afunto, nominatim, "Geocodes addresses", "HTTPS")
Rel(afunto, smtp, "Sends email", "SMTP")
Rel(afunto, objectstore, "Stores / serves assets", "S3 API")

@enduml
